{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAnyoneOutsideThisAccount",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::food-scanner-unknown-foods",
        "arn:aws:s3:::food-scanner-unknown-foods/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalAccount": "753093280070"
        }
      }
    },
    {
      "Sid": "DenyUnencryptedConnections",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::food-scanner-unknown-foods",
        "arn:aws:s3:::food-scanner-unknown-foods/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
