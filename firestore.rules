rules_version = '2';

// NutriScan Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// Every user can only read and change their own meals, profile and water log.
// Only the admin email can read everyone's meals (used by the /admin page).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == "sidpatil1.sp@gmail.com";
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // meals/{autoId} with a userId field
    match /meals/{mealId} {
      allow read:   if ownsExisting() || isAdmin();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // users/{uid} profile and goals
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // water/{uid}_{yyyy-mm-dd}
    match /water/{docId} {
      allow read:   if signedIn() && docId.matches(request.auth.uid + '_.*');
      allow create, update: if signedIn()
                            && docId.matches(request.auth.uid + '_.*')
                            && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && docId.matches(request.auth.uid + '_.*');
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
